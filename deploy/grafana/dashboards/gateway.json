{
 "uid": "vigil-gateway",
 "title": "Vigil — Gateway",
 "schemaVersion": 39,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "type": "text",
   "title": "",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 3
   },
   "options": {
    "mode": "markdown",
    "content": "**Ingestion**: machines publish over MQTT; the Go gateway forwards every message to Kafka, keyed by machine so that each machine's messages stay in order. A load test on a CI runner reached 16,000 msg/s without loss ([report](https://github.com/kabilaymen/vigil/blob/main/bench/LOADTEST.md))."
   }
  },
  {
   "type": "timeseries",
   "title": "Ingest rate (msg/s)",
   "gridPos": {
    "x": 0,
    "y": 3,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (kind) (rate(vigil_gateway_messages_received_total[1m]))",
     "legendFormat": "{{kind}}"
    }
   ],
   "description": "50 machines × 2 telemetry messages per second; alarms and status changes are rare.",
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "MQTT receipt → Kafka acknowledgement (p50 / p99)",
   "gridPos": {
    "x": 12,
    "y": 3,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    }
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum by (le) (rate(vigil_gateway_produce_latency_seconds_bucket[1m])))",
     "legendFormat": "p50"
    },
    {
     "expr": "histogram_quantile(0.99, sum by (le) (rate(vigil_gateway_produce_latency_seconds_bucket[1m])))",
     "legendFormat": "p99"
    }
   ],
   "description": "The producer waits up to 5 ms to batch messages, hence a p50 of about 5 ms."
  },
  {
   "type": "stat",
   "title": "Produce errors (5m)",
   "gridPos": {
    "x": 0,
    "y": 11,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "expr": "sum(increase(vigil_gateway_produce_errors_total[5m]))"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Malformed (5m)",
   "gridPos": {
    "x": 6,
    "y": 11,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "expr": "sum(increase(vigil_gateway_malformed_total[5m]))"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Status events per minute (offline, then online again)",
   "gridPos": {
    "x": 12,
    "y": 11,
    "w": 12,
    "h": 5
   },
   "targets": [
    {
     "expr": "sum(increase(vigil_gateway_messages_received_total{kind=\"status\"}[1m]))",
     "legendFormat": "status events"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "min": 0,
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60
     }
    },
    "overrides": []
   },
   "description": "Each crash produces an offline event (the broker's Last Will) and an online one when the machine reconnects."
  }
 ]
}