{
 "uid": "vigil-detector",
 "title": "Vigil — Failure detector",
 "schemaVersion": 39,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "type": "text",
   "title": "",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 3
   },
   "options": {
    "mode": "markdown",
    "content": "**Failure detection**: 50 simulated machines; one crashes every 45 s and one stalls (stays connected but goes silent) every 30 s. Crashes are caught through MQTT's Last Will, stalls by a phi accrual detector on each machine's heartbeats. [Code](https://github.com/kabilaymen/vigil) · other dashboards: Gateway, Fleet history (Dashboards menu)"
   }
  },
  {
   "type": "stat",
   "title": "Machines down",
   "gridPos": {
    "x": 0,
    "y": 3,
    "w": 4,
    "h": 5
   },
   "targets": [
    {
     "expr": "vigil_detector_machines_down"
    }
   ],
   "description": "Machines currently suspected (silent) or disconnected. The simulator crashes one every 45 s and stalls one every 30 s."
  },
  {
   "type": "stat",
   "title": "Machines tracked",
   "gridPos": {
    "x": 4,
    "y": 3,
    "w": 4,
    "h": 5
   },
   "targets": [
    {
     "expr": "vigil_detector_machines_tracked"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Detector lag",
   "gridPos": {
    "x": 8,
    "y": 3,
    "w": 4,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    }
   },
   "targets": [
    {
     "expr": "vigil_detector_consume_lag_seconds"
    }
   ],
   "description": "How far behind the stream the detector is. Above 2 s it stops judging machines: the silence would be its own."
  },
  {
   "type": "timeseries",
   "title": "Alerts / min",
   "gridPos": {
    "x": 12,
    "y": 3,
    "w": 12,
    "h": 5
   },
   "targets": [
    {
     "expr": "sum by (type) (increase(vigil_detector_alerts_total[1m]))",
     "legendFormat": "{{type}}"
    }
   ],
   "description": "suspected = silent but still connected (phi accrual); connection_lost = the broker published the machine's Last Will."
  },
  {
   "type": "stat",
   "title": "Stalls caught within 1.5 s (last hour)",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 6,
    "h": 8
   },
   "description": "Share of phi-accrual alerts raised within 1.5 s of the machine's last message. Slower ones can happen when a machine stalls just after reconnecting: the detector does not judge a machine until it has relearned its rhythm (10 heartbeats).",
   "targets": [
    {
     "expr": "sum(increase(vigil_detector_detection_seconds_bucket{type=\"suspected\",le=\"1.5\"}[1h])) / sum(increase(vigil_detector_detection_seconds_count{type=\"suspected\"}[1h]))",
     "instant": true,
     "legendFormat": "within 1.5 s"
    },
    {
     "expr": "round(sum(increase(vigil_detector_detection_seconds_count{type=\"suspected\"}[1h])))",
     "instant": true,
     "legendFormat": "detections"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value_and_name",
    "orientation": "vertical"
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "fixed",
      "fixedColor": "green"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "within 1.5 s"
      },
      "properties": [
       {
        "id": "unit",
        "value": "percentunit"
       },
       {
        "id": "decimals",
        "value": 0
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "detections"
      },
      "properties": [
       {
        "id": "unit",
        "value": "none"
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "text"
        }
       }
      ]
     }
    ]
   }
  },
  {
   "type": "stat",
   "title": "Crashes caught within 1.5 s (last hour)",
   "gridPos": {
    "x": 6,
    "y": 8,
    "w": 6,
    "h": 8
   },
   "description": "Share of Last Will alerts within 1.5 s of the machine's last message. A machine that was already stalled when it crashed counts as slow.",
   "targets": [
    {
     "expr": "sum(increase(vigil_detector_detection_seconds_bucket{type=\"connection_lost\",le=\"1.5\"}[1h])) / sum(increase(vigil_detector_detection_seconds_count{type=\"connection_lost\"}[1h]))",
     "instant": true,
     "legendFormat": "within 1.5 s"
    },
    {
     "expr": "round(sum(increase(vigil_detector_detection_seconds_count{type=\"connection_lost\"}[1h])))",
     "instant": true,
     "legendFormat": "detections"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value_and_name",
    "orientation": "vertical"
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "fixed",
      "fixedColor": "green"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "within 1.5 s"
      },
      "properties": [
       {
        "id": "unit",
        "value": "percentunit"
       },
       {
        "id": "decimals",
        "value": 0
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "detections"
      },
      "properties": [
       {
        "id": "unit",
        "value": "none"
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "text"
        }
       }
      ]
     }
    ]
   }
  },
  {
   "type": "timeseries",
   "title": "Highest φ in the fleet (alert at 8)",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "description": "Suspicion level of the most suspicious machine, recomputed every 200 ms from each machine's own heartbeat rhythm. Each spike above 8 is a stalled or crashed machine.",
   "targets": [
    {
     "expr": "max(clamp_max(vigil_detector_phi, 20))",
     "legendFormat": "highest φ"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "min": 0,
     "max": 20,
     "color": {
      "mode": "fixed",
      "fixedColor": "orange"
     },
     "custom": {
      "thresholdsStyle": {
       "mode": "line"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "transparent",
        "value": null
       },
       {
        "color": "red",
        "value": 8
       }
      ]
     }
    },
    "overrides": []
   }
  }
 ]
}