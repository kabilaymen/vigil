{
  "uid": "vigil-detector",
  "title": "Vigil — Failure detector",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {"type": "stat", "title": "Machines down", "gridPos": {"x": 0, "y": 0, "w": 4, "h": 5},
     "targets": [{"expr": "vigil_detector_machines_down"}]},
    {"type": "stat", "title": "Machines tracked", "gridPos": {"x": 4, "y": 0, "w": 4, "h": 5},
     "targets": [{"expr": "vigil_detector_machines_tracked"}]},
    {"type": "stat", "title": "Detector lag", "gridPos": {"x": 8, "y": 0, "w": 4, "h": 5},
     "fieldConfig": {"defaults": {"unit": "s"}},
     "targets": [{"expr": "vigil_detector_consume_lag_seconds"}]},
    {"type": "timeseries", "title": "Alerts / min", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 5},
     "targets": [{"expr": "sum by (type) (increase(vigil_detector_alerts_total[1m]))", "legendFormat": "{{type}}"}]},
    {"type": "timeseries", "title": "Detection time (silence when declared) — p50 / p95", "gridPos": {"x": 0, "y": 5, "w": 12, "h": 8},
     "fieldConfig": {"defaults": {"unit": "s"}},
     "targets": [
       {"expr": "histogram_quantile(0.5, sum by (le, type) (rate(vigil_detector_detection_seconds_bucket[10m])))", "legendFormat": "p50 {{type}}"},
       {"expr": "histogram_quantile(0.95, sum by (le, type) (rate(vigil_detector_detection_seconds_bucket[10m])))", "legendFormat": "p95 {{type}}"}]},
    {"type": "timeseries", "title": "φ per machine (threshold 8)", "gridPos": {"x": 12, "y": 5, "w": 12, "h": 8},
     "fieldConfig": {"defaults": {"max": 20, "min": 0}},
     "options": {"legend": {"showLegend": false}},
     "targets": [{"expr": "clamp_max(vigil_detector_phi, 20)", "legendFormat": "{{machine}}"}]}
  ]
}
